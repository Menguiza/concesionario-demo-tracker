rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }
    function esAdmin() {
      return request.auth != null && rolDe(request.auth.uid) == 'admin';
    }
    // Rol intermedio: gestiona la operación diaria (equipos, cola, reservas,
    // vehículos, pico y placa, etiquetas) igual que admin, pero NUNCA puede
    // crear/borrar cuentas ni tocar 'activo'/'rol' de un usuario — eso queda
    // exclusivo de admin a propósito (control de licenciamiento).
    function esGerente() {
      return request.auth != null && rolDe(request.auth.uid) == 'gerente';
    }
    function esAnfitriona() {
      return request.auth != null && rolDe(request.auth.uid) == 'anfitriona';
    }
    function esDirectivo() {
      return request.auth != null && rolDe(request.auth.uid) == 'directivo';
    }
    function esComercial() {
      return request.auth != null && rolDe(request.auth.uid) == 'comercial';
    }
    function autenticado() {
      return request.auth != null;
    }

    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create, delete: if esAdmin();
      // Anfitriona solo puede tocar ultimaLlegada (marcar llegada); directivo
      // solo puede tocar tags (asignar etiquetas a un comercial); gerente
      // puede tocar datos operativos de cualquiera (teléfono, horario,
      // etiquetas, llegada) pero nunca 'activo' ni 'rol' — crear/desactivar
      // gente sigue siendo exclusivo de admin.
      allow update: if esAdmin() ||
        (esAnfitriona() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaLlegada'])) ||
        (esDirectivo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags'])) ||
        (esGerente() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'telefono', 'horarioSemanal', 'ultimaLlegada']));
    }

    match /etiquetas/{id} {
      allow read: if autenticado();
      allow create, update, delete: if esAdmin() || esGerente();
    }

    match /equipos/{id} {
      allow read: if autenticado();
      allow write: if esAdmin() || esGerente();
    }

    match /estadoSemana/{id} {
      allow read: if autenticado();
      allow write: if esAdmin() || esGerente() || esAnfitriona();
    }

    match /historialEquipos/{id} {
      allow read: if autenticado();
      allow create: if esAdmin() || esGerente() || esAnfitriona();
    }

    match /colaEquipo/{id} {
      // Lectura abierta a cualquier autenticado: comercial/directivo la usan
      // para ver su propio estado de fila en el dashboard de inicio. Sigue
      // siendo solo dato operativo (turnos), y la escritura sigue exclusiva
      // de quien gestiona la cola.
      allow read: if autenticado();
      allow write: if esAdmin() || esGerente() || esAnfitriona();
    }

    match /clientes/{id} {
      allow read: if autenticado();
      allow create: if esAdmin() || esGerente() || esAnfitriona();
      allow update: if esAdmin() || esGerente() || esAnfitriona() || (esComercial() && resource.data.comercialAsignadoId == request.auth.uid);
    }

    match /vehiculos/{id} {
      allow read: if autenticado();
      allow write: if esAdmin() || esGerente() || esAnfitriona();
      // Comercial/directivo pueden registrar su propio movimiento (entrega o
      // devolución de un vehículo que reservaron), pero solo tocando estos
      // campos — no pueden crear vehículos ni editar placa/marca/etc.
      allow update: if (esComercial() || esDirectivo()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'movimientoActualId', 'quienTiene']);
    }

    match /movimientos/{id} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    match /reservas/{id} {
      allow read: if autenticado();
      allow write: if esAdmin() || esGerente() || esAnfitriona() || esDirectivo();
      // Comercial puede cerrar (marcar cumplida/omitida) únicamente su
      // propia reserva, o aquella donde quedó como "responsable" de un
      // préstamo a cliente — y solo esos dos campos. El "&&" corta antes de
      // leer .uid cuando responsable es null, para no reventar la regla con
      // un error de "propiedad de null".
      allow update: if esComercial() &&
        (resource.data.solicitadoPor.uid == request.auth.uid ||
          (resource.data.responsable != null && resource.data.responsable.uid == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultado', 'movimientoId']);
      // devolucionResultado/movimientoDevolucionId se marcan automáticamente
      // cuando a ALGUIEN MÁS le toca recibir un vehículo que otra persona
      // nunca devolvió (ver registrarMovimiento) — no hay forma de saber de
      // antemano cuál es "la reserva propia" del que hace el reemplazo, así
      // que cualquier comercial puede tocar esos dos campos en cualquier
      // reserva. Sigue sin poder tocar resultado/movimientoId/lo demás.
      allow update: if esComercial() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devolucionResultado', 'movimientoDevolucionId']);
    }

    match /clientesMaestro/{id} {
      allow read: if autenticado();
      allow create, update: if esAdmin() || esGerente() || esAnfitriona();
    }

    match /picoYPlacaConfig/{id} {
      allow read: if autenticado();
      allow write: if esAdmin() || esGerente();
    }
  }
}
